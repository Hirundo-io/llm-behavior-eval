# Upstream revisions the native benchmarks pin: dataset and reference-code commits.
#
# Renovate (.github/renovate.json) proposes a new commit when the tracked branch
# moves; tests/test_upstream_revisions.py then fails until the code agrees. Run
# `python scripts/sync_upstream_revisions.py` to move the pin in the benchmark's
# files, review the upstream changes, and update checksums and anything else
# derived from the data in the same pull request.
#
# A benchmark adds one entry of exactly three lines per pinned revision:
#
#   # renovate: datasource=github-digest depName=<owner>/<repo> currentValue=<branch>
#   # source: <file from the repository root>:<CONSTANT>
#   <BENCHMARK>_<WHAT>_REV=<40-character commit>
#
# <CONSTANT> is a module-level string constant, or <CONSTANT>["<key>"] for one
# value of a module-level dict literal. A Hugging Face dataset is a Git
# repository, tracked with the git-refs datasource:
#
#   # renovate: datasource=git-refs depName=<org>/<dataset> packageName=https://huggingface.co/datasets/<org>/<dataset> currentValue=main
#
# Keep entries sorted by key, separated by a blank line.

# renovate: datasource=github-digest depName=HumanCompatibleAI/tensor-trust-data currentValue=main
# source: packages/security/tensor_trust/src/llm_behavior_eval/security/tensor_trust/dataset.py:DATA_COMMIT
TENSOR_TRUST_DATA_REV=747a75e096761ebc01bd3970158827326b4add23

# renovate: datasource=github-digest depName=HumanCompatibleAI/tensor-trust currentValue=main
# source: packages/security/tensor_trust/src/llm_behavior_eval/security/tensor_trust/task.py:REFERENCE_COMMIT
TENSOR_TRUST_REFERENCE_CODE_REV=f0b055451415e23d444703fbb8a47daf1d4b2c3c
